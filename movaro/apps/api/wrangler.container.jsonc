{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mudavi-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mudavi.app,https://www.mudavi.app"
  },
  "containers": [
    {
      "class_name": "MudaviApiContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "MudaviApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MudaviApiContainer"]
    }
  ]
}
