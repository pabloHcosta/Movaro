{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mudavi-public-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://mudavi.app,https://www.mudavi.app"
  }
}
